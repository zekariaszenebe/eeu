rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global ID validation helper
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 100 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper to validate a FeederInterruption document
    function isValidInterruption(data) {
      return data.keys().hasAll(['id', 'feederName', 'district', 'type', 'status', 'startTime', 'estimatedRestorationTime', 'affectedArea', 'remark', 'lastUpdated'])
        && data.id is string && data.id.size() <= 100
        && data.feederName is string && data.feederName.size() <= 200
        && data.district is string && data.district.size() <= 100
        && data.type is string && data.type.size() <= 100
        && data.status is string && data.status.size() <= 100
        && data.startTime is string && data.startTime.size() <= 100
        && data.estimatedRestorationTime is string && data.estimatedRestorationTime.size() <= 100
        && data.affectedArea is string && data.affectedArea.size() <= 5000
        && data.remark is string && data.remark.size() <= 5000
        && data.lastUpdated is string && data.lastUpdated.size() <= 100;
    }

    // Helper to validate a SystemNotification document
    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'type', 'title', 'message', 'timestamp', 'read'])
        && data.id is string && data.id.size() <= 100
        && data.type is string && data.type.size() <= 50
        && data.title is string && data.title.size() <= 200
        && data.message is string && data.message.size() <= 5000
        && data.timestamp is string && data.timestamp.size() <= 100
        && data.read is bool
        && (!data.keys().hasAny(['feederId']) || (data.feederId is string && data.feederId.size() <= 100));
    }

    // Helper to validate a PresetFeeder document
    function isValidPresetFeeder(data) {
      return data.keys().hasAll(['feederStr'])
        && data.feederStr is string && data.feederStr.size() <= 5000;
    }

    // Helper to validate a HubRecord document
    function isValidHubRecord(data) {
      return data.keys().hasAll(['no', 'address', 'region', 'csc', 'dummyBp', 'rsg', 'dispatcherName', 'dispatcherId', 'customerServiceTlId', 'officeLocation'])
        && data.no is number
        && data.address is string && data.address.size() <= 10000
        && data.region is string && data.region.size() <= 200
        && data.csc is string && data.csc.size() <= 200
        && data.dummyBp is string && data.dummyBp.size() <= 100
        && data.rsg is string && data.rsg.size() <= 100
        && data.dispatcherName is string && data.dispatcherName.size() <= 200
        && data.dispatcherId is string && data.dispatcherId.size() <= 100
        && data.customerServiceTlId is string && data.customerServiceTlId.size() <= 100
        && data.officeLocation is string && data.officeLocation.size() <= 5000;
    }

    // Helper to validate a TeamLeaderNote document
    function isValidTeamLeaderNote(data) {
      return data.keys().hasAll(['id', 'content', 'author', 'timestamp', 'isUrgent'])
        && data.id is string && data.id.size() <= 100
        && data.content is string && data.content.size() <= 10000
        && data.author is string && data.author.size() <= 200
        && data.timestamp is string && data.timestamp.size() <= 100
        && data.isUrgent is bool;
    }

    // Helper to validate a CustomerContact document
    function isValidCustomerContact(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'category'])
        && (data.keys().size() >= 4 && data.keys().size() <= 6)
        && data.id is string && data.id.size() <= 100
        && data.name is string && data.name.size() <= 300
        && data.phone is string && data.phone.size() <= 200
        && data.category is string && (data.category == 'head_regional' || data.category == 'sheger_city' || data.category == 'regional_hotline')
        && (!data.keys().hasAny(['locationInfo']) || (data.locationInfo is string && data.locationInfo.size() <= 5000))
        && (!data.keys().hasAny(['hotlineShortCode']) || (data.hotlineShortCode is string && data.hotlineShortCode.size() <= 100));
    }

    // Helper to validate a TeamLeaderUser document
    function isValidTeamLeader(data) {
      return data.keys().hasAll(['id', 'username', 'password', 'name'])
        && data.id is string && data.id.size() <= 100
        && data.username is string && data.username.size() <= 200
        && data.password is string && data.password.size() <= 200
        && data.name is string && data.name.size() <= 200
        && (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 100))
        && (!data.keys().hasAny(['district']) || (data.district is string && data.district.size() <= 200))
        && (!data.keys().hasAny(['mustChangePassword']) || (data.mustChangePassword is bool));
    }

    // Helper to validate a Feedback document
    function isValidFeedback(data) {
      return data.keys().hasAll(['id', 'rating', 'category', 'feedbackText', 'submittedBy', 'targetEmail', 'timestamp'])
        && data.id is string && data.id.size() <= 100
        && data.rating is number
        && data.category is string && data.category.size() <= 200
        && data.feedbackText is string && data.feedbackText.size() <= 10000
        && data.submittedBy is string && data.submittedBy.size() <= 200
        && data.targetEmail is string && data.targetEmail.size() <= 200
        && data.timestamp is string && data.timestamp.size() <= 100;
    }

    // Matches for our collections
    match /interruptions/{interruptionId} {
      allow read: if true;
      allow create, update: if true; // temporarily allow to fix validation issues
      allow delete: if isValidId(interruptionId);
    }
    
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isValidId(notificationId);
    }
    
    match /presetFeeders/{feederId} {
      allow read: if true;
      allow create, update: if isValidId(feederId) && isValidPresetFeeder(request.resource.data);
      allow delete: if isValidId(feederId);
    }
    
    match /hubRecords/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId) && isValidHubRecord(request.resource.data);
      allow delete: if isValidId(recordId);
    }

    match /teamLeaderNotes/{noteId} {
      allow read: if true;
      allow create, update: if isValidId(noteId) && isValidTeamLeaderNote(request.resource.data);
      allow delete: if isValidId(noteId);
    }

    match /customerContacts/{contactId} {
      allow read: if true;
      allow create, update: if isValidId(contactId) && isValidCustomerContact(request.resource.data);
      allow delete: if isValidId(contactId);
    }
    
    match /teamLeaders/{tlId} {
      allow read: if true;
      allow create, update: if isValidId(tlId) && isValidTeamLeader(request.resource.data);
      allow delete: if isValidId(tlId);
    }
    
    match /feedbacks/{feedbackId} {
      allow read, create, update: if isValidId(feedbackId) && isValidFeedback(request.resource.data);
      allow delete: if isValidId(feedbackId);
    }

    match /systemSettings/{settingId} {
      allow read, write: if isValidId(settingId);
    }
  }
}
