{
  "entities": {
    "FeederInterruption": {
      "title": "Feeder Interruption",
      "description": "Information about a power line or feeder station outage.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "feederName": { "type": "string" },
        "district": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "startTime": { "type": "string" },
        "estimatedRestorationTime": { "type": "string" },
        "affectedArea": { "type": "string" },
        "remark": { "type": "string" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["id", "feederName", "district", "type", "status", "startTime", "estimatedRestorationTime", "affectedArea", "remark", "lastUpdated"]
    },
    "SystemNotification": {
      "title": "System Notification",
      "description": "Log notifications for grid alerts and updates.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "feederId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "type", "title", "message", "timestamp", "read"]
    },
    "PresetFeeder": {
      "title": "Preset Feeder",
      "description": "Preset feeder line code/name with associated communities.",
      "type": "object",
      "properties": {
        "feederStr": { "type": "string" }
      },
      "required": ["feederStr"]
    },
    "HubRecord": {
      "title": "Hub Record",
      "description": "Details for a CSC address hub record.",
      "type": "object",
      "properties": {
        "no": { "type": "integer" },
        "address": { "type": "string" },
        "region": { "type": "string" },
        "csc": { "type": "string" },
        "dummyBp": { "type": "string" },
        "rsg": { "type": "string" },
        "dispatcherName": { "type": "string" },
        "dispatcherId": { "type": "string" },
        "customerServiceTlId": { "type": "string" },
        "officeLocation": { "type": "string" }
      },
      "required": ["no", "address", "region", "csc", "dummyBp", "rsg", "dispatcherName", "dispatcherId", "customerServiceTlId", "officeLocation"]
    },
    "TeamLeaderNote": {
      "title": "Team Leader Note",
      "description": "A notice or announcement posted by team leaders for the call center agents.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "timestamp": { "type": "string" },
        "isUrgent": { "type": "boolean" }
      },
      "required": ["id", "content", "author", "timestamp", "isUrgent"]
    },
    "CustomerContact": {
      "title": "Customer Contact",
      "description": "A phone number or shortcode contact record for customers and regional offices.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "category": { "type": "string" },
        "locationInfo": { "type": "string" },
        "hotlineShortCode": { "type": "string" }
      },
      "required": ["id", "name", "phone", "category"]
    },
    "TeamLeaderUser": {
      "title": "Team Leader User",
      "description": "Team leader user account credential and team assignment.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "name": { "type": "string" },
        "district": { "type": "string" },
        "mustChangePassword": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "username", "password", "name"]
    }
  },
  "firestore": {
    "interruptions/{interruptionId}": {
      "schema": "FeederInterruption",
      "description": "Active and past feeder station outages."
    },
    "notifications/{notificationId}": {
      "schema": "SystemNotification",
      "description": "Grid warning and resolution notifications."
    },
    "presetFeeders/{feederId}": {
      "schema": "PresetFeeder",
      "description": "Registered preset feeder lines."
    },
    "hubRecords/{recordId}": {
      "schema": "HubRecord",
      "description": "Registered CSC Address Hub Records."
    },
    "teamLeaderNotes/{noteId}": {
      "schema": "TeamLeaderNote",
      "description": "Notices from Team Leaders to Agents."
    },
    "customerContacts/{contactId}": {
      "schema": "CustomerContact",
      "description": "Customer contact and hotline records."
    },
    "teamLeaders/{tlId}": {
      "schema": "TeamLeaderUser",
      "description": "Registered Team Leader accounts and credentials."
    }
  }
}
